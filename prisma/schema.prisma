generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Models ─────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App Models ──────────────────────────────────────────────
model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  timezone        String    @default("Asia/Kolkata")
  telegramChatId  String?
  telegramUsername String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?
  isActive        Boolean   @default(true)

  accounts            Account[]
  sessions            Session[]
  degreeProfiles      DegreeProfile[]
  subjects            Subject[]
  semesters           Semester[]
  schedules           Schedule[]
  attendanceRecords   AttendanceRecord[]
  auditLogs           AuditLog[]
  achievements        Achievement[]
  notificationSetting NotificationSetting?
  classExceptions     ClassException[]
  pushSubscriptions   PushSubscription[]
  friendGroupMemberships FriendGroupMember[]
}

model DegreeProfile {
  id          String     @id @default(cuid())
  userId      String
  name        String
  degreeType  String?
  institution String?
  isCurrent   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesters   Semester[]

  @@index([userId])
}

model Semester {
  id              String         @id @default(cuid())
  userId          String
  degreeProfileId String?
  name            String
  startDate       DateTime
  endDate         DateTime
  isCurrent       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  degreeProfile DegreeProfile? @relation(fields: [degreeProfileId], references: [id], onDelete: SetNull)
  subjects      Subject[]

  @@index([userId])
  @@index([degreeProfileId])
  @@index([userId, isCurrent])
}

model Subject {
  id                 String   @id @default(cuid())
  userId             String
  semesterId         String?
  name               String
  code               String?
  instructorName     String?
  minAttendancePct   Float    @default(75.0)
  colorHex           String   @default("#7C3AED")
  icon               String   @default("book")
  totalClassesHeld   Int      @default(0)
  totalPresent       Int      @default(0)
  totalAbsent        Int      @default(0)
  totalLate          Int      @default(0)
  totalExcused       Int      @default(0)
  totalCancelled     Int      @default(0)
  currentPercentage  Float    @default(0.0)
  streakCount        Int      @default(0)
  longestStreak      Int      @default(0)
  isArchived         Boolean  @default(false)
  archiveReason      String?
  reminderEnabled    Boolean  @default(true)
  reminderBeforeMin  Int      @default(15)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester          Semester?           @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  schedules         Schedule[]
  attendanceRecords AttendanceRecord[]
  achievements      Achievement[]
  classExceptions   ClassException[]

  @@index([userId])
  @@index([semesterId])
  @@index([userId, isArchived])
}

model Schedule {
  id             String    @id @default(cuid())
  subjectId      String
  userId         String
  dayOfWeek      Int
  startTime      String
  endTime        String
  room           String?
  building       String?
  isActive       Boolean   @default(true)
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]

  @@index([subjectId])
  @@index([userId, dayOfWeek])
}

model AttendanceRecord {
  id           String    @id @default(cuid())
  subjectId    String
  userId       String
  scheduleId   String?
  date         DateTime  @db.Date
  status       String
  source       String    @default("manual")
  notes        String?
  markedAt     DateTime  @default(now())
  editedAt     DateTime?
  editedReason String?

  subject  Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@unique([subjectId, userId, date, scheduleId])
  @@index([userId])
  @@index([subjectId])
  @@index([date])
  @@index([userId, date])
  @@index([subjectId, date])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
}

model NotificationSetting {
  id                      String  @id @default(cuid())
  userId                  String  @unique
  telegramEnabled       Boolean @default(false)
  telegramPreClass      Boolean @default(true)
  telegramDangerAlert   Boolean @default(true)
  telegramDailyBrief    Boolean @default(true)
  telegramWeeklyReport  Boolean @default(false)
  telegramBeforeMinutes Int     @default(15)
  emailEnabled          Boolean @default(false)
  emailPreClass         Boolean @default(true)
  emailDangerAlert      Boolean @default(true)
  emailDailyBrief       Boolean @default(true)
  emailWeeklyReport     Boolean @default(false)
  alarmEnabled            Boolean @default(true)
  alarmPreClass           Boolean @default(true)
  alarmDangerThreshold    Float   @default(5.0)
  alarmSound              String  @default("default")
  alarmVibrate            Boolean @default(true)
  alarmBeforeMinutes      Int     @default(10)
  pushEnabled             Boolean @default(true)
  quietHoursEnabled       Boolean @default(true)
  quietHoursStart         String  @default("22:00")
  quietHoursEnd           String  @default("07:00")
  dailyBriefTime          String  @default("08:00")
  weeklyReportDay         Int     @default(0)
  goalModeEnabled         Boolean @default(false)
  goalTargetPct           Float   @default(85.0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ClassException {
  id            String   @id @default(cuid())
  userId        String
  subjectId     String?
  exceptionType String
  date          DateTime @db.Date
  reason        String?
  allSubjects   Boolean  @default(false)
  createdAt     DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Achievement {
  id        String   @id @default(cuid())
  userId    String
  badgeKey  String
  subjectId String?
  earnedAt  DateTime @default(now())
  metadata  String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey, subjectId])
  @@index([userId])
}

// ─── Friend Groups ──────────────────────────────────────────
model FriendGroup {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdBy String
  createdAt DateTime @default(now())

  members   FriendGroupMember[]
}

model FriendGroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group FriendGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

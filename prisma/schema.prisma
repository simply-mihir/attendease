generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── NextAuth Models ─────────────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App Models ──────────────────────────────────────────────
model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  timezone        String    @default("Asia/Kolkata")
  telegramChatId  String?
  telegramUsername String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?
  isActive        Boolean   @default(true)

  accounts            Account[]
  sessions            Session[]
  degreeProfiles      DegreeProfile[]
  subjects            Subject[]
  semesters           Semester[]
  schedules           Schedule[]
  attendanceRecords   AttendanceRecord[]
  auditLogs           AuditLog[]
  achievements        Achievement[]
  notificationSetting NotificationSetting?
  classExceptions     ClassException[]
  pushSubscriptions   PushSubscription[]
  friendGroupMemberships FriendGroupMember[]
  reminders           Reminder[]
  sentNotifications   SentNotification[]
  scheduleOverrides   ScheduleOverride[]
}

model DegreeProfile {
  id          String     @id @default(cuid())
  userId      String
  name        String
  degreeType  String?
  institution String?
  isCurrent   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  semesters   Semester[]

  @@index([userId])
}

model Semester {
  id              String         @id @default(cuid())
  userId          String
  degreeProfileId String?
  name            String
  startDate       DateTime
  endDate         DateTime
  isCurrent       Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  degreeProfile DegreeProfile? @relation(fields: [degreeProfileId], references: [id], onDelete: SetNull)
  subjects      Subject[]
  holidays      Holiday[]
  examPeriods   ExamPeriod[]

  @@index([userId])
  @@index([degreeProfileId])
  @@index([userId, isCurrent])
}

model Subject {
  id                 String   @id @default(cuid())
  userId             String
  semesterId         String?
  name               String
  code               String?
  instructorName     String?
  minAttendancePct   Float    @default(75.0)
  colorHex           String   @default("#7C3AED")
  icon               String   @default("book")
  totalClassesHeld   Int      @default(0)
  totalPresent       Int      @default(0)
  totalAbsent        Int      @default(0)
  totalLate          Int      @default(0)
  totalExcused       Int      @default(0)
  totalCancelled     Int      @default(0)
  currentPercentage  Float    @default(0.0)
  streakCount        Int      @default(0)
  longestStreak      Int      @default(0)
  isArchived         Boolean  @default(false)
  archiveReason      String?
  reminderEnabled    Boolean  @default(true)
  reminderBeforeMin  Int      @default(15)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  semester          Semester?           @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  schedules         Schedule[]
  attendanceRecords AttendanceRecord[]
  achievements      Achievement[]
  classExceptions     ClassException[]
  reminders           Reminder[]
  scheduleOverrides   ScheduleOverride[]
  swappedOverrides    ScheduleOverride[] @relation("SwapSubject")

  @@index([userId])
  @@index([semesterId])
  @@index([userId, isArchived])
}

model Schedule {
  id             String    @id @default(cuid())
  subjectId      String
  userId         String
  dayOfWeek      Int
  startTime      String
  endTime        String
  room           String?
  building       String?
  isActive       Boolean   @default(true)
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceRecords AttendanceRecord[]

  @@index([subjectId])
  @@index([userId, dayOfWeek])
}

model AttendanceRecord {
  id           String    @id @default(cuid())
  subjectId    String
  userId       String
  scheduleId   String?
  date         DateTime  @db.Date
  status       String
  source       String    @default("manual")
  notes        String?
  markedAt     DateTime  @default(now())
  editedAt     DateTime?
  editedReason String?

  subject  Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@unique([subjectId, userId, date, scheduleId])
  @@index([userId])
  @@index([subjectId])
  @@index([date])
  @@index([userId, date])
  @@index([subjectId, date])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
}

model NotificationSetting {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ===== Master channel toggles =====
  pushEnabled      Boolean @default(false)
  emailEnabled     Boolean @default(false)
  telegramEnabled  Boolean @default(false)

  // ===== Per-type toggles — Push =====
  pushDailyBrief     Boolean @default(true)
  pushPreClass       Boolean @default(true)
  pushDangerAlert    Boolean @default(true)
  pushWeeklyReport   Boolean @default(true)
  pushDailyReport    Boolean @default(true)

  // ===== Per-type toggles — Email =====
  emailDailyBrief    Boolean @default(true)
  emailPreClass      Boolean @default(true)
  emailDangerAlert   Boolean @default(true)
  emailWeeklyReport  Boolean @default(true)
  emailDailyReport   Boolean @default(true)

  // ===== Per-type toggles — Telegram =====
  telegramDailyBrief    Boolean @default(true)
  telegramPreClass      Boolean @default(true)
  telegramDangerAlert   Boolean @default(true)
  telegramWeeklyReport  Boolean @default(true)
  telegramDailyReport   Boolean @default(true)

  // ===== Timing =====
  dailyBriefHour    Int @default(7)     // 0-23, user's local timezone
  dailyBriefMinute  Int @default(0)     // 0-59
  dailyReportHour   Int @default(20)    // Default 8 PM
  dailyReportMinute Int @default(0)
  preClassMinutes   Int @default(15)    // Minutes before class

  // ===== Restored Legacy Fields =====
  quietHoursEnabled Boolean @default(true)
  quietHoursStart   String  @default("22:00")
  quietHoursEnd     String  @default("07:00")
  goalModeEnabled   Boolean @default(false)
  goalTargetPct     Float   @default(85.0)
  weeklyReportDay   Int     @default(0)
  dailyBriefTime    String  @default("08:00")
  telegramBeforeMinutes Int @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ClassException {
  id            String   @id @default(cuid())
  userId        String
  subjectId     String?
  exceptionType String
  date          DateTime @db.Date
  reason        String?
  allSubjects   Boolean  @default(false)
  createdAt     DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Achievement {
  id        String   @id @default(cuid())
  userId    String
  badgeKey  String
  subjectId String?
  earnedAt  DateTime @default(now())
  metadata  String?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey, subjectId])
  @@index([userId])
}

// ─── Friend Groups ──────────────────────────────────────────
model FriendGroup {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdBy String
  createdAt DateTime @default(now())

  members   FriendGroupMember[]
}

model FriendGroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group FriendGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model Reminder {
  id             String   @id @default(cuid())
  userId         String
  subjectId      String?
  title          String
  description    String?
  category       String   @default("other") // "assignment", "extra_class", "exam", "other"
  dueDate        DateTime @db.Date
  dueTime        String?
  priority       String   @default("medium") // "low", "medium", "high"
  isCompleted    Boolean  @default(false)
  notifyPush     Boolean  @default(true)
  notifyAlarm    Boolean  @default(true)
  notifyEmail    Boolean  @default(false)
  notifyTelegram Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([subjectId])
  @@index([userId, isCompleted])
  @@index([userId, dueDate])
}

model SentNotification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "daily-brief", "pre-class", "danger-alert", "weekly-report"
  key       String   // unique key like "daily-brief:2026-07-31"
  sentAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@index([sentAt])
}

model Holiday {
  id         String   @id @default(cuid())
  semesterId String
  name       String
  date       DateTime
  createdAt  DateTime @default(now())

  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@unique([semesterId, date])
  @@index([semesterId])
}

model ExamPeriod {
  id         String   @id @default(cuid())
  semesterId String
  name       String
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime @default(now())

  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@index([semesterId])
}

model ScheduleOverride {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime // The specific date this override applies to
  subjectId       String
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  type            String   // "reschedule" | "cancel" | "extra" | "swap"
  originalTime    String?  // Original time slot (e.g., "09:00")
  newTime         String?  // New time slot (e.g., "14:00") — null if cancelled
  swapSubjectId   String?  // For swaps: the other subject involved
  swapSubject     Subject? @relation("SwapSubject", fields: [swapSubjectId], references: [id])
  note            String?  // User's original message / note
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, date])
  @@index([subjectId])
}
